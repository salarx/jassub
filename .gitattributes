# Normalise every text file to LF in the repository.
#
# Without this the tree drifted: four files were committed as LF while the rest stayed CRLF, and the diff
# for those was 57% line-ending flips carrying no content - `git blame` on them points at one commit for
# every line. core.autocrlf hides it locally, since checkout rewrites the working tree either way, so the
# mix only shows up in the blobs, which is what review, blame and every rebase actually see.
#
# eol=lf rather than leaving the working tree to core.autocrlf: the Makefile and the shell scripts are run
# inside the build container, and make treats a trailing CR as part of the value.
* text=auto eol=lf

# Binaries: never touch these.
*.wasm  binary
*.woff2 binary
*.gif   binary
*.png   binary
*.jpg   binary
*.ttf   binary
*.otf   binary

# Windows-only, and cmd/PowerShell want CRLF.
*.ps1 text eol=crlf
