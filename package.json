{
  "name": "webass",
  "version": "2.5.14",
  "description": "ASS/SSA subtitle renderer for browsers. libass compiled to WebAssembly, GPU-accelerated with WebGPU and WebGL2.",
  "main": "dist/jassub.js",
  "type": "module",
  "files": [
    "dist/wasm/*",
    "dist/worker/*",
    "dist/jassub.*",
    "dist/debug.*",
    "dist/default.woff2",
    "!dist/wasm/jassub-worker-modern.js",
    "README.md",
    "LICENSE",
    "index.d.ts",
    "src/**/*.ts",
    "!src/default.woff2"
  ],
  "scripts": {
    "build": "tsc --noCheck",
    "dev": "vite --host",
    "docker:build": "docker build -t thaunknown/jassub-build .",
    "docker:run": "docker run -it --rm -v ${PWD}:/code --name thaunknown_jassub-build thaunknown/jassub-build:latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salarx/webASS.git"
  },
  "keywords": [
    "subtitles",
    "subtitle",
    "subtitle-renderer",
    "ass",
    "ssa",
    "ass-subtitles",
    "libass",
    "webassembly",
    "wasm",
    "emscripten",
    "webgpu",
    "webgl2",
    "html5-video",
    "video",
    "video-player",
    "offscreencanvas",
    "typescript",
    "aegisub"
  ],
  "author": "ThaUnknown",
  "license": "LGPL-2.1-or-later AND (FTL OR GPL-2.0-or-later) AND MIT AND MIT-Modern-Variant AND ISC AND NTP AND Zlib AND BSL-1.0",
  "bugs": {
    "url": "https://github.com/salarx/webASS/issues"
  },
  "homepage": "https://github.com/salarx/webASS",
  "dependencies": {
    "abslink": "^1.2.2",
    "lfa-ponyfill": "^1.1.0",
    "rvfc-polyfill": "^1.0.8",
    "throughput": "^1.0.2"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.69",
    "eslint-config-standard-universal": "^1.0.9",
    "typescript": "^5.2.2",
    "vite": "^7.3.1"
  }
}
